NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://localhost:27017/message-service

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=message-service
KAFKA_MESSAGE_TOPIC=messages.events
KAFKA_CONSUMER_GROUP=message-search-indexer
KAFKA_CONNECTION_TIMEOUT=10000
KAFKA_RETRY_INITIAL_TIME=300
KAFKA_RETRY_COUNT=8

ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=messages-v1

DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100